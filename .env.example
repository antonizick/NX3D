NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# JWT secret - generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-48-chars

# Cookie settings
COOKIE_SECRET=change-me-another-long-random-secret

# Tenant data root (absolute path or relative to server package root)
TENANTS_ROOT=../../tenants

# Admin frontend origin (for CORS)
ADMIN_ORIGIN=http://localhost:5173
GAME_ORIGIN=http://localhost:5174

# TOTP issuer name shown in authenticator apps
TOTP_ISSUER=CustomWolf
